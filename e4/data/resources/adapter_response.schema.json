{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E4 adapter submission response",
  "description": "Offline structured response contract for a trusted adapter source module.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {"const": "ready"},
        "source": {"type": "string", "minLength": 1},
        "config_schema": {
          "type": "object",
          "description": "Inline Draft 2020-12 schema for the JSON configuration object."
        }
      },
      "required": ["status", "source", "config_schema"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {"const": "needs_input"},
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "type": {"enum": ["string", "number", "integer", "boolean", "object", "array"]},
              "reason": {"type": "string", "minLength": 1}
            },
            "required": ["name", "type"],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "required_fields"],
      "additionalProperties": false
    }
  ]
}
